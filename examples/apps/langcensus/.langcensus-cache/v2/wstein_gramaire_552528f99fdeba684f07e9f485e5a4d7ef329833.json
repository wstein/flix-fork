{"files":[{"additions":4,"blob_url":"https://github.com/wstein/gramaire/blob/552528f99fdeba684f07e9f485e5a4d7ef329833/site%2Fsrc%2Fshared%2Fgramaire-topbar.mjs","changes":8,"contents_url":"https://api.github.com/repos/wstein/gramaire/contents/site%2Fsrc%2Fshared%2Fgramaire-topbar.mjs?ref=552528f99fdeba684f07e9f485e5a4d7ef329833","deletions":4,"filename":"site/src/shared/gramaire-topbar.mjs","patch":"@@ -73,7 +73,7 @@ const TEMPLATE = `\n     display: flex;\n     align-items: center;\n     gap: 1.125em;\n-    padding: 0.75em 1.375em;\n+    padding: 0.25em 1.375em;\n     border-bottom: 1px solid var(--border, #ddd6f8);\n     background: var(--bg, #fff);\n   }\n@@ -91,7 +91,7 @@ const TEMPLATE = `\n     font-weight: 700;\n     letter-spacing: -0.04em;\n     line-height: 1;\n-    font-size: 1.1875em;\n+    font-size: 2em;\n     white-space: nowrap;\n   }\n   .wm .ink { color: var(--fg, #16181d); }\n@@ -136,7 +136,7 @@ const TEMPLATE = `\n     color: var(--fg-muted, #5b4d92);\n     background: none;\n     border: none;\n-    padding: 0.4375em 0.625em;\n+    padding: 0.3125em 0.625em;\n     border-radius: 6px;\n     cursor: pointer;\n     white-space: nowrap;\n@@ -159,7 +159,7 @@ const TEMPLATE = `\n \n <div class=\"bar\" part=\"bar\">\n   <a class=\"brand\" part=\"brand\" id=\"brand\">\n-    <svg class=\"mark\" viewBox=\"0 0 96 96\" width=\"28\" height=\"28\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Gramaire\">\n+    <svg class=\"mark\" viewBox=\"0 0 96 96\" width=\"40\" height=\"40\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Gramaire\">\n       <g transform=\"matrix(1.3665595,0,0,1.3665595,-17.594856,-17.594856)\" fill=\"none\" stroke=\"var(--fg, #16181d)\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n         <path d=\"M 18,48 H 33\"></path>\n         <path d=\"M 63,48 C 70,48 71,31 78,31\"></path>","raw_url":"https://github.com/wstein/gramaire/raw/552528f99fdeba684f07e9f485e5a4d7ef329833/site%2Fsrc%2Fshared%2Fgramaire-topbar.mjs","sha":"d28ec5045198f5ed47c3e99b9f0ec25a20c96f7c","status":"modified"},{"additions":8,"blob_url":"https://github.com/wstein/gramaire/blob/552528f99fdeba684f07e9f485e5a4d7ef329833/site%2Fsrc%2Fstyles%2Fstarlight-bridge.css","changes":11,"contents_url":"https://api.github.com/repos/wstein/gramaire/contents/site%2Fsrc%2Fstyles%2Fstarlight-bridge.css?ref=552528f99fdeba684f07e9f485e5a4d7ef329833","deletions":3,"filename":"site/src/styles/starlight-bridge.css","patch":"@@ -59,12 +59,17 @@\n    * bare Landing page, with no such wrapper, never had. Zeroing these\n    * here (an unlayered rule beats Starlight's own `@layer starlight.base`\n    * unconditionally) makes the topbar's own padding the only source\n-   * everywhere. `--sl-nav-height` is left alone — it already matches the\n-   * topbar's natural rendered height, so the fixed header's content\n-   * offset (`.main-frame`'s padding-top) stays correct.\n+   * everywhere. `--sl-nav-height` also needs to track the topbar's actual\n+   * rendered height explicitly (Starlight's own default, 56px/64px at the\n+   * >=50em breakpoint, only coincidentally matched it before the topbar\n+   * was shrunk) — `.main-frame`'s `padding-top: calc(var(--sl-nav-height)\n+   * + …)` content offset is wrong otherwise, showing as a gap/double\n+   * border below the fixed header. Keep this in sync with .bar's actual\n+   * height in gramaire-topbar.mjs (measure it, don't guess).\n    */\n   --sl-nav-pad-x: 0px;\n   --sl-nav-pad-y: 0px;\n+  --sl-nav-height: 49px;\n }\n \n /*","raw_url":"https://github.com/wstein/gramaire/raw/552528f99fdeba684f07e9f485e5a4d7ef329833/site%2Fsrc%2Fstyles%2Fstarlight-bridge.css","sha":"54e7154c53a844b31b5d31ab934e4edf95bad1d0","status":"modified"},{"additions":0,"blob_url":"https://github.com/wstein/gramaire/blob/552528f99fdeba684f07e9f485e5a4d7ef329833/site%2Ftests%2Fvisual%2Fshell.spec.ts-snapshots%2Fbrand-dark-chromium-darwin.png","changes":0,"contents_url":"https://api.gith