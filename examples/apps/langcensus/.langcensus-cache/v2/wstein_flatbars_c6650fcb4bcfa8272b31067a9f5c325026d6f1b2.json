{"files":[{"additions":4,"blob_url":"https://github.com/wstein/flatbars/blob/c6650fcb4bcfa8272b31067a9f5c325026d6f1b2/packages%2Flinter%2Fsrc%2FLinter%2FAliases.purs","changes":5,"contents_url":"https://api.github.com/repos/wstein/flatbars/contents/packages%2Flinter%2Fsrc%2FLinter%2FAliases.purs?ref=c6650fcb4bcfa8272b31067a9f5c325026d6f1b2","deletions":1,"filename":"packages/linter/src/Linter/Aliases.purs","patch":"@@ -73,7 +73,10 @@ aliasWarningsOf src = (aliasWarnings <<< _.nodes) <$> parse src\n -- | the legacy bare index, `partial-block` the Handlebars-derived block-body name.\n -- | A lint table, deliberately *not* a `scopedSpecs` field or `synonymOf` — the\n -- | engine installs both spellings and renders them identically; only the editor\n--- | tooling expresses the preference.\n+-- | tooling expresses the preference. (Complements `Linter.Lift.liftLoopVar`,\n+-- | which maps the same names to the MaxBars `loop.` *surface* when re-sugaring\n+-- | across dialects; here we normalise the *bare* name within core/MaxBars. Both\n+-- | agree `index0` is canonical, not `index`.)\n scopedCanonical :: Array (Tuple String String)\n scopedCanonical =\n   [ Tuple \"index\" \"index0\"","raw_url":"https://github.com/wstein/flatbars/raw/c6650fcb4bcfa8272b31067a9f5c325026d6f1b2/packages%2Flinter%2Fsrc%2FLinter%2FAliases.purs","sha":"619bc804d9b43705ab3137c6ee246b3381829446","status":"modified"},{"additions":6,"blob_url":"https://github.com/wstein/flatbars/blob/c6650fcb4bcfa8272b31067a9f5c325026d6f1b2/packages%2Flinter%2Fsrc%2FLinter%2FLift.purs","changes":6,"contents_url":"https://api.github.com/repos/wstein/flatbars/contents/packages%2Flinter%2Fsrc%2FLinter%2FLift.purs?ref=c6650fcb4bcfa8272b31067a9f5c325026d6f1b2","deletions":0,"filename":"packages/linter/src/Linter/Lift.purs","patch":"@@ -280,6 +280,12 @@ exprWith span arg expr = case expr of\n \n -- | A scoped loop-variable name (and the ADR-006 aliases) → its field on the\n -- | MaxBars `loop` object (ADR-021). `Nothing` for any other name.\n+-- |\n+-- | NB: this targets the MaxBars *surface* spelling (`loop.index0`) because lift\n+-- | re-sugars core → MaxBars. That is NOT in tension with `Linter.Aliases`'\n+-- | `scopedCanonical` (`index` → bare `index0`): different jobs — lift rewrites\n+-- | *across* dialects to the `loop.` surface, the canon lint normalises the *bare*\n+-- | scoped name *within* core/MaxBars. Both treat `index0` (not `index`) as canonical.\n liftLoopVar :: Ident -> Maybe String\n liftLoopVar = case _ of\n   \"index0\" -> Just \"loop.index0\"","raw_url":"https://github.com/wstein/flatbars/raw/c6650fcb4bcfa8272b31067a9f5c325026d6f1b2/packages%2Flinter%2Fsrc%2FLinter%2FLift.purs","sha":"bee3ad96af61dd386967d91f3a2f7ad5a29634ab","status":"modified"},{"additions":5,"blob_url":"https://github.com/wstein/flatbars/blob/c6650fcb4bcfa8272b31067a9f5c325026d6f1b2/scripts%2Fcheck-parity.mjs","changes":5,"contents_url":"https://api.github.com/repos/wstein/flatbars/contents/scripts%2Fcheck-parity.mjs?ref=c6650fcb4bcfa8272b31067a9f5c325026d6f1b2","deletions":0,"filename":"scripts/check-parity.mjs","patch":"@@ -69,6 +69,11 @@ for (const [label, value, expectFalsy] of WITNESS) {\n if (!fail.length) ok(`${WITNESS.length} witness values: identical in both, falsy set = { false, null, \"\", [], {} }, 0 truthy`);\n \n // ── 2. Render sweep over a shared core corpus ────────────────────────────────\n+// MAINTAINER NOTE: this corpus is the cheap place to pin the parity contract —\n+// when a new construct lands that both dialects share (a new prelude op, a block\n+// form), add a line here so the contract keeps pace. Keep entries in *core syntax*\n+// only (so both parse to the same AST); a divergent surface form (operators,\n+// dialect-specific loop-var spelling) belongs in the documented exceptions, not here.\n console.log(\"\\nRender parity (RawBars ≡ MaxBars) over shared core syntax:\");\n const CORPUS = [\n   { id: \"escape\", tpl: `{{{escapeHtml (lookup this \"h\")}}}`, data: { h