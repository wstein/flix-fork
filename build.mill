package build

import mill.*
import mill.scalalib.*
import mill.scalalib.Assembly.*

/** The narrow client a build tool compiles against, rather than the compiler itself.
  *
  * Java, with no Scala on its classpath: a Scala client would drag the Scala runtime into every
  * consumer's plugin classpath. Deliberately a separate module from `flix` so it cannot acquire a
  * dependency on the compiler by accident -- the value here is the surface it does *not* expose.
  */
object flixClient extends JavaModule {

  def javacOptions = Seq("--release", "21")

  def mvnDeps = Seq(mvn"com.google.code.gson:gson:2.11.0")

  /** Tests that read canned contract documents through a fake process runner.
    *
    * No compiler is started. What is under test is the reading of the document -- which positions
    * mean, and which outputs are refused -- and that is exactly what a compiler run would make slow
    * and hard to provoke: an empty diagnostics list, a diagnostic with no source location, and the
    * output of a compiler too old to know the flag are all a nuisance to obtain for real and
    * trivial to state as text.
    */
  object test extends JavaTests, TestModule.Junit5 {
    def mvnDeps = Seq(mvn"org.junit.jupiter:junit-jupiter:5.11.4")
  }
}

object flix extends ScalaModule {

  def scalaVersion = "2.13.18"

  // moduleDir resolves to <root>/flix/ (module name appended).
  // Our sources live at <root>/main/src, so navigate up one level.
  val root = moduleDir / os.up

  def sources = Task.Sources(root / "main" / "src")

  def mainClass = Some("ca.uwaterloo.flix.Main")

  def mvnDeps = Seq(
    mvn"org.java-websocket:Java-WebSocket:1.6.0",
    mvn"org.jline:jline:3.30.9",
    mvn"org.json4s::json4s-native:4.0.7",
    mvn"org.ow2.asm:asm:9.9.1",
    mvn"org.commonmark:commonmark:0.24.0",
    mvn"org.commonmark:commonmark-ext-gfm-tables:0.24.0",
    mvn"info.picocli:picocli:4.7.7",
    mvn"org.apache.commons:commons-lang3:3.20.0",
    mvn"io.get-coursier::coursier:2.1.24",
    mvn"org.tomlj:tomlj:1.1.1",            // determines antlr version
    mvn"org.antlr:antlr4-runtime:4.11.1",
    mvn"org.slf4j:slf4j-nop:2.0.17",       // silence JLine logger
    mvn"org.eclipse.lsp4j:org.eclipse.lsp4j:1.0.0",
    // Declared rather than left transitive: `LspServer` imports it directly, and the BSP
    // server pins the version that `bsp4j` below would otherwise drag backwards.
    mvn"org.eclipse.lsp4j:org.eclipse.lsp4j.jsonrpc:1.0.0",
    // The Build Server Protocol bindings, for `flix bsp`. `bsp4j` asks for jsonrpc 0.20.1;
    // it references only `Either`, the `services` annotations and two gson type adapters,
    // all of which 1.0.0 still has, so unifying upward is safe -- `TestBspLinkage` is what
    // holds that claim.
    //
    // The two lines after the exclusion are a **reachability contract**, not a claim about
    // what bsp4j depends on, and each was established by a test failing rather than by
    // reading a pom.
    //
    // `generator` is an Xtend active annotation used at bsp4j's own build time, so none of
    // its code is reachable at runtime -- with one exception that the poms do not show:
    // bsp4j's generated `toString` calls xtext's `ToStringBuilder`, which arrives only
    // with `generator`. lsp4j 1.0.0 has its own `ToStringBuilder` and puts no xtext on the
    // classpath, so excluding `generator` alone makes every `toString` on a BSP object
    // throw. That is not cosmetic: lsp4j renders a message's params when it logs a failed
    // request, so the throw lands inside lsp4j's own error handling -- a failure while
    // reporting a failure. `xbase.lib` (166 KB) supplies that one class.
    //
    // And the path continues: `ToStringBuilder` reaches `com.google.common.base.Strings`.
    // Guava is here for that reach and nothing else -- it was absent from this jar before
    // bsp4j, and nothing else on the classpath references it. Excluding it was tried and
    // threw at the first `toString`. See the guava rule in `assemblyRules`, which keeps
    // only what that path needs, and `TestBspAssembly`, which drives the path in a JVM
    // holding nothing but the assembled jar.
    //
    // No bsp4j release avoids this chain: 2.1.1 is the newest stable, 2.2.0 was never
    // released, and both milestones use the same generator.
    mvn"ch.epfl.scala:bsp4j:2.1.1".exclude("org.eclipse.lsp4j" -> "org.eclipse.lsp4j.generator"),
    mvn"org.eclipse.xtext:org.eclipse.xtext.xbase.lib:2.28.0",
    mvn"com.dynatrace.hash4j:hash4j:0.30.0"
  )

  def scalacOptions = Seq(
    "-Xfatal-warnings",
    "-Ypatmat-exhaust-depth", "400",
    "-release", "21",
    "-opt:inline:ca.uwaterloo.**",
    "-Xmixin-force-forwarders:false",
    "-Xsource:3",
    "-Ytasty-reader"
  )

  def javacOptions = Seq("--release", "21")

  // Manifest: Main-Class is set by mainClass; add Enable-Native-Access
  def manifest = Task {
    super.manifest().add("Enable-Native-Access" -> "ALL-UNNAMED")
  }

  // Fat JAR: create a proper non-executable JAR
  override def prependShellScript: T[String] = ""

  // Fat JAR: exclude META-INF signatures, first-wins for duplicates
  def assemblyRules = Seq(
    Rule.ExcludePattern("META-INF/.*\\.(RSA|SF|DSA)"),

    // ── Test files (saves ~5 MB) ────────────────────────────
    // The resources directive includes main/ which brings in main/test/.
    // These .flix and .scala test files are not needed at runtime.
    Rule.ExcludePattern("test/.*"),

    // ── Scala source files (saves ~4 MB) ────────────────────
    // The resources directive includes main/src/ for .flix library files,
    // but also pulls in .scala compiler sources. Only ClassList.txt and
    // .flix files are needed at runtime; the compiled .class files are
    // already in the JAR.
    Rule.ExcludePattern("src/ca/.*\\.scala"),

    // ── zstd-jni native libraries (saves ~15 MB) ────────────
    // Coursier bundles zstd-jni native binaries for every OS/arch.
    // These are optional: coursier falls back to a Java implementation.
    // The v0.66.1 release JAR never included them.
    Rule.ExcludePattern("linux/.*"),
    Rule.ExcludePattern("win/.*"),
    Rule.ExcludePattern("darwin/.*"),
    Rule.ExcludePattern("freebsd/.*"),

    // ── Coursier transitive dependencies (saves ~4 MB) ──────
    // Coursier pulls in Maven build infrastructure (Plexus) and
    // compression libraries that are not needed at runtime.
    // Plexus: Maven dependency injection / archiver framework.
    Rule.ExcludePattern("org/codehaus/plexus/.*"),
    // commons-compress/io/codec: used by plexus-archiver, not by coursier itself.
    Rule.ExcludePattern("org/apache/commons/compress/.*"),
    Rule.ExcludePattern("org/apache/commons/io/.*"),
    Rule.ExcludePattern("org/apache/commons/codec/.*"),
    // aircompressor: Java zstd/lz4 implementation, optional for coursier.
    Rule.ExcludePattern("io/airlift/compress/.*"),
    // xbean-reflect: dependency injection helper for Plexus.
    Rule.ExcludePattern("org/apache/xbean/.*"),

    // ── Guava, except the one package that is reachable (saves ~2.4 MB) ──
    // Guava arrives only with xtext's `xbase.lib`, which is on the classpath only for
    // `ToStringBuilder`, which bsp4j's generated `toString` calls. Nothing else here
    // references guava at all -- it was absent from this jar before bsp4j was added.
    // `ToStringBuilder` needs exactly `com.google.common.base.Strings`, so `base/` stays
    // and `collect/`, `cache/`, `io/`, `hash/` and the rest go: 6 MB down to 365 KB.
    //
    // The rest of `xbase.lib` does reference `com/google/common/collect`, so this is a
    // claim about what is *reachable*, not about what is referenced -- and it is held by
    // `TestBspAssembly`, which drives the assembled jar in a separate JVM and prints a
    // protocol object. Reading the poms is what got this wrong the first time.
    Rule.ExcludePattern("com/google/common/(?!base/).*"),

    // ── Benchmark build artifacts ────────────────────────────
    // main/src/resources/benchmark/build/ is gitignored, untracked local
    // output from running benchmarks -- whatever a given developer happens
    // to have run locally. Left in, it would make the assembled jar
    // non-reproducible across machines.
    Rule.ExcludePattern("benchmark/build/.*")
  ) ++ super.assemblyRules

  // Include .flix, .json, .zip, and ClassList.txt from main/ in the JAR: main/ is an
  // extra resource root so those files land in the assembly, matching what the
  // pre-Mill Gradle build shipped.
  //
  // Named as its own def rather than inlined: Mill's Task macro names an
  // anonymous Task.Sources(...) after its enclosing def via sourcecode.Name,
  // so inlining it directly inside `resources` caches it under the key
  // "resources" too -- the same key as the outer task -- which manifests as
  // a circular "flix.resources depends on flix.resources" dependency.
  def extraResources = Task.Sources(
    root / "main" / "src" / "resources",
    root / "main"
  )

  // Also append the generated version resource consumed by Version.scala.
  override def resources = Task {
    extraResources() ++ Seq(versionResource())
  }

  // Re-evaluated on every build (it shells out to git, which Mill cannot hash like a
  // tracked source file). The glob is anchored to a digit deliberately: a bare `v*`
  // also matches this repository's unrelated `vendor-*` tags, which parse as neither
  // release form and would silently degrade the reported version to 0.0.0. Falls back
  // to "unknown" in a shallow clone or a checkout with no reachable release tag,
  // rather than failing the build over a value that only affects a version string.
  def gitDescribe: T[String] = Task.Input {
    val result = os.proc("git", "describe", "--tags", "--long", "--dirty", "--match", "v[0-9]*")
      .call(cwd = root, check = false, stderr = os.Pipe)
    if (result.exitCode == 0) result.out.trim() else "unknown"
  }

  /** Writes [[gitDescribe]] to a resource file so [[ca.uwaterloo.flix.api.Version]] can read it at runtime. */
  def versionResource: T[PathRef] = Task {
    os.write(Task.dest / "version.txt", gitDescribe())
    PathRef(Task.dest)
  }

  // ── Test Module ─────────────────────────────────────────
  object test extends ScalaTests, TestModule.ScalaTest {
    def sources = Task.Sources(flix.root / "main" / "test")

    def mvnDeps = Seq(
      mvn"org.scalatest::scalatest:3.2.20",
      mvn"org.scala-lang.modules::scala-xml:2.4.0",
    )

    def forkArgs = Seq("-Xmx3g")
    def forkWorkingDir = root
    def testSandboxWorkingDir = false
    def testParallelism = false
    def forkEnv = super.forkEnv() ++ Task.env
  }

  // ── Custom Tasks ────────────────────────────────────────

  /** Runs a single ScalaTest suite in a forked JVM against the test module's classpath. */
  private def runSuite(suite: String, classpath: Seq[PathRef], env: Map[String, String]) =
    os.proc("java", "-Xmx3g",
      "-cp", classpath.map(_.path).mkString(java.io.File.pathSeparator),
      "org.scalatest.tools.Runner",
      "-s", suite, "-o"
    ).call(stdout = os.Inherit, stderr = os.Inherit, stdin = os.Inherit, cwd = root, env = env)

  /** Run: ./mill flix.testFuzzerSuite */
  def testFuzzerSuite = Task {
    runSuite("flix.fuzzers.FuzzerSuite", test.runClasspath(), Task.env)
  }

  /** Run: ./mill flix.testExamples */
  def testExamples = Task {
    runSuite("ca.uwaterloo.flix.ExampleSuite", test.runClasspath(), Task.env)
  }

  /** Run: ./mill flix.testIDECompletion */
  def testIDECompletion = Task {
    runSuite("ca.uwaterloo.flix.api.lsp.TestCompletionProvider", test.runClasspath(), Task.env)
  }

  /** Run: ./mill flix.testPackageManager */
  def testPackageManager = Task {
    runSuite("ca.uwaterloo.flix.tools.pkg.PackageManagerSuite", test.runClasspath(), Task.env)
  }

  /**
   * Run: ./mill flix.testBsp
   *
   * The BSP tests that need something the ordinary suite cannot give them: a built
   * assembly, or a process of their own. It depends on `assembly()` rather than
   * assuming a jar is lying around, because the suite's whole subject is what the
   * *packaged* compiler can do -- `assemblyRules` drops most of guava, and an
   * exclusion that went too far is invisible to any test run on the full classpath.
   * Without the dependency these tests cancel themselves and report green.
   *
   * The in-process BSP tests are not here. They are fast and belong in `flix.test`,
   * where a dependency bump is noticed by whoever made it.
   */
  def testBsp = Task {
    assembly()
    runSuite("ca.uwaterloo.flix.api.bsp.BspSuite", test.runClasspath(), Task.env)
  }

  /**
   * Run: ./mill flix.formatterDiffReport
   *
   * Reports what `flix format --canonical` would do to the corpus, ranked by how
   * much of each file it rewrites. Run it after changing a layout rule: the
   * formatter's automated properties show that formatting destroys nothing and
   * are all satisfied by output that is consistently wrong, so this ranking is
   * the only instrument that sees a rule firing where it should not.
   */
  def formatterDiffReport = Task {
    runSuite("ca.uwaterloo.flix.tools.fmt.FormatterDiffReport", test.runClasspath(), Task.env)
  }

  /**
   * Run: ./mill flix.updateCanonicalFixtures
   *
   * Regenerates the expected output of the canonical formatter fixtures under
   * main/test/resources/fmt/canonical, then leaves the diff for a human to read.
   * It is a separate task rather than a self-healing test on purpose: an
   * expectation that rewrites itself on failure records whatever the formatter
   * currently does, which turns the golden corpus into a mirror instead of a gate.
   */
  def updateCanonicalFixtures = Task {
    runSuite("ca.uwaterloo.flix.tools.fmt.CanonicalFixtureUpdate", test.runClasspath(), Task.env)
  }

  /**
   * Run: ./mill flix.breakEvidenceReport
   *
   * Measures where the corpus's authors break `let` bindings and `if`/`else`,
   * so that the refusal recorded as D24 can be reopened on evidence. It asserts
   * nothing: the numbers are the deliverable, and D24 asks for a measurement
   * rather than an argument before any break rule is added.
   */
  def breakEvidenceReport = Task {
    runSuite("ca.uwaterloo.flix.tools.fmt.BreakEvidenceReport", test.runClasspath(), Task.env)
  }

  /** Run: ./mill flix.vscode */
  def vscode() = Task.Command {
    val envFile = root / ".env"
    if (!os.exists(envFile)) {
      throw new Exception("Create .env in the project root with:\n  VSCODE_PATH=/path/to/vscode/project")
    }
    val targetDir = os.read.lines(envFile)
      .map(_.trim)
      .filter(_.nonEmpty)
      .filterNot(_.startsWith("#"))
      .collectFirst { case s if s.startsWith("VSCODE_PATH=") =>
        s.stripPrefix("VSCODE_PATH=").trim
      }
      .getOrElse(throw new Exception(".env must contain: VSCODE_PATH=/path/to/vscode/project"))
    val jar = assembly().path
    os.copy.over(jar, os.Path(targetDir) / "flix.jar")
  }
}
